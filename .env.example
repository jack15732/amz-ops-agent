# ---- DeepSeek (chat + Function Calling) ----
# 推荐：LLM 用 DeepSeek，embedding 用本地 HF 或 SiliconFlow。
DEEPSEEK_API_KEY=
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=120

# ---- SiliconFlow (BGE-M3 embedding / Qwen fallback) ----
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_PROVIDER=huggingface   # siliconflow | huggingface | hash
EMBEDDING_MODEL=moka-ai/m3e-base
# 使用 BGE-M3 时改成：
# EMBEDDING_PROVIDER=siliconflow
# EMBEDDING_MODEL=BAAI/bge-m3

# ---- Tavily Web Search (Agentic RAG 联网兜底) ----
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
WEB_SEARCH_ENABLED=true

# ---- Runtime ----
AMZ_DATA_DIR=data/runtime
AMZ_LOG_LEVEL=INFO
AMZ_AUTO_INGEST=true
AMZ_QDRANT_MODE=local            # local | server | memory
QDRANT_URL=http://localhost:6333
# AMZ_CONFIG=config/settings.yaml
