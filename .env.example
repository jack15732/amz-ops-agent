# ---- SiliconFlow (OpenAI-compatible) ----
# 用于 BGE-M3 embedding + Qwen function calling；不配置时自动降级到
# HuggingFace 本地 embedding（如已安装 sentence-transformers）+ 规则型 Agent。
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# bge-m3 (1024 dim) / Qwen2.5-7B-Instruct / Qwen2.5-72B-Instruct
EMBEDDING_PROVIDER=siliconflow   # siliconflow | huggingface | hash
EMBEDDING_MODEL=BAAI/bge-m3
LLM_PROVIDER=siliconflow         # siliconflow | none
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# ---- Runtime ----
AMZ_DATA_DIR=data/runtime
AMZ_LOG_LEVEL=INFO
AMZ_AUTO_INGEST=true
AMZ_QDRANT_MODE=local            # local | server | memory
QDRANT_URL=http://localhost:6333
# AMZ_CONFIG=config/settings.yaml
